DB_NAME=personas_db
DB_USER=app
DB_PASSWORD=app_pass

# Autenticación SSO (Keycloak, Microsoft Entra, etc.)
# Con false, opera en modo local asumiendo "dev-user".
# Con true y activando Keycloak (--profile auth), valida tokens JWT vía JWKS.
AUTH_ENABLED=false
OIDC_ISSUER=http://localhost:8081/realms/gestion
JWKS_URL=http://keycloak:8080/realms/gestion/protocol/openid-connect/certs

# Configuración n8n
N8N_HOST=localhost
N8N_PORT=5678
